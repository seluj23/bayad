# Your app's public address (must be https for sign-in and install to work)
PUBLIC_URL=https://bayad.example.com

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these Google accounts can sign in (comma-separated). Leave empty to allow any account,
# each with its own separate data.
ALLOWED_EMAILS=you@gmail.com

# Shown on /privacy, /terms and /about as the address people write to for questions and data deletion.
CONTACT_EMAIL=you@gmail.com

# Optional limits and backups (defaults shown)
# MAX_RECORDS_PER_USER=5000   # bills, income and loans one account can sync
# BACKUP_KEEP=7               # daily database snapshots kept in /data/backups; 0 turns them off
# REMINDER_HOUR=8            # local hour for the daily notification
# TRUST_PROXY=1               # set to 0 if the app is reached directly, not through Dokploy/Traefik
