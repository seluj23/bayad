# Your app's public address (must be https for sign-in and install to work)
PUBLIC_URL=https://bayad.example.com

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these Google accounts can sign in (comma-separated). Leave empty to allow any account,
# each with its own separate data.
ALLOWED_EMAILS=you@gmail.com
